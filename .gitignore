# GeoClaw crosscheck: keep the exported case inputs (topo.xyz/dtopo.txyz/
# gauges.txt/sim-gauges.csv/meta.json) tracked so the comparison is exactly
# reproducible; ignore solver run artifacts only.
tools/geoclaw-crosscheck/case-*/_output/
tools/geoclaw-crosscheck/case-*/fort.*
tools/geoclaw-crosscheck/case-*/gauge0000*.txt
tools/geoclaw-crosscheck/case-*/*.data

# GSI pilot: raw mosaics (33MB, regenerable from tools/fetch-gsi-dem.js) and
# the tile cache stay local; the blended jp-sanriku-gsi.json IS committed.
public/geojson/gsi/*.json
tools/data/gsi-tiles/

# K-NET/KiK-net waveform packages (account-gated NIED downloads; the portal
# terms prohibit redistribution — regenerable via tools/fetch-kyoshin-waveforms.js)
public/geojson/strong-motion-waveforms/

# First-boot admin password pointer file (server.js writes it once)
admin-password.txt

# Local agent/session tooling (plans, scratch) — never commit
.zcode/
